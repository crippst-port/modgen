<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="/ai/placement/modgen/db" VERSION="20250109" COMMENT="Tables for aiplacement_modgen">
    <TABLES>
        <TABLE NAME="aiplacement_modgen_aigen" COMMENT="Tracks AI-generated course modules">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course module ID"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="When record was created"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="cmid_uk" TYPE="unique" FIELDS="cmid"/>
                <KEY NAME="courseid_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="courseid" UNIQUE="false" FIELDS="courseid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="aiplacement_modgen_templates" COMMENT="CSV templates for module generation">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Template name"/>
                <FIELD NAME="description" TYPE="text" NOTNULL="false" COMMENT="Template description"/>
                <FIELD NAME="fileid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="File ID from mdl_files"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Display order"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="When record was created"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="When record was last modified"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="sortorder" UNIQUE="false" FIELDS="sortorder"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="aiplacement_modgen_jobs" COMMENT="Background job tracking for section creation">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course ID"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="User who queued the job"/>
                <FIELD NAME="action" TYPE="char" LENGTH="50" NOTNULL="true" COMMENT="Action type: create_themes or create_weeks"/>
                <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" COMMENT="Job status: queued, running, completed, failed"/>
                <FIELD NAME="parameters" TYPE="text" NOTNULL="true" COMMENT="JSON-encoded job parameters"/>
                <FIELD NAME="result" TYPE="text" NOTNULL="false" COMMENT="JSON-encoded result or error message"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="When job was queued"/>
                <FIELD NAME="timestarted" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="When job started running"/>
                <FIELD NAME="timecompleted" TYPE="int" LENGTH="10" NOTNULL="false" COMMENT="When job completed or failed"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="courseid_fk" TYPE="foreign" FIELDS="courseid" REFTABLE="course" REFFIELDS="id"/>
                <KEY NAME="userid_fk" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>