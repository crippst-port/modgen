{{!
    @template aiplacement_modgen/ai_policy_acceptance

    AI policy acceptance form.

    Context variables required for this template:
    * aipolicyacceptance - Policy acceptance heading
    * aipolicyinfo - Policy information text
    * acceptaipolicy - Accept policy checkbox label
    * accept - Accept button text
    * courseid - Course ID
    * embedded - Whether in embedded mode
    * ajax - Whether in AJAX mode
    * sesskey - Session key
    * formaction - Form action URL

    Example context (json):
    {
        "aipolicyacceptance": "AI Policy Acceptance",
        "aipolicyinfo": "Please read and accept our AI usage policy",
        "acceptaipolicy": "I accept the AI usage policy",
        "accept": "Accept",
        "courseid": 123,
        "embedded": 0,
        "ajax": 0,
        "sesskey": "abc123",
        "formaction": "/ai/placement/modgen/prompt.php"
    }
}}
<div class="ai-policy-acceptance">
    <h4>{{aipolicyacceptance}}</h4>
    <div class="alert alert-info">
        <p>{{aipolicyinfo}}</p>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="acceptpolicy">
        <label class="form-check-label" for="acceptpolicy">
            {{acceptaipolicy}}
        </label>
    </div>
    <form id="ai-policy-form" method="post" action="{{formaction}}">
        <input type="hidden" name="courseid" value="{{courseid}}">
        <input type="hidden" name="acceptpolicy" value="1">
        <input type="hidden" name="embedded" value="{{embedded}}">
        <input type="hidden" name="ajax" value="{{ajax}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <button type="submit" id="ai-policy-submit-btn" class="btn btn-primary">
            {{accept}}
        </button>
    </form>
</div>
