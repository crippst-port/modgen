{{!
    @template aiplacement_modgen/course_nav

    Module Assistant toolbar shown at the top of a course page while editing.

    Context variables required for this template:
    * logourl - URL of the logo drawn faintly behind the bar
    * unavailable - Why nothing can be built in this course, shown in place of the Quick Add menu (optional)
    * showquickaddmenu - Whether the Quick Add menu is shown
    * showquickadd - Whether any of New Theme(s), New Week(s) and Assessments section is offered
    * showassessments - Whether the Assessments section is offered (only at the top of the course)
    * shownewtheme - Whether New Theme(s) is offered (top of the course, Flexible sections only)
    * shownewweek - Whether New Week(s) is offered (anywhere in Flexible sections, the top of the course otherwise)
    * showtemplatefromfile - Whether Structure from file is offered
    * generatorurl - URL of the Structure from file page
    * showgenerator - Whether Structure from prompt is offered
    * showcheckstructure - Whether Check Structure is offered
    * checkstructureurl - URL of the Check Structure page
    * showhelplinks - Whether the Help and Advice menu is shown
    * helplinks - Links for that menu, each with text and url

    Example context (json):
    {
        "logourl": "https://example.com/theme/image.php/boost/aiplacement_modgen/1/compact_logo",
        "showquickaddmenu": true,
        "showquickadd": true,
        "showassessments": true,
        "shownewtheme": true,
        "shownewweek": true,
        "showtemplatefromfile": true,
        "generatorurl": "https://example.com/ai/placement/modgen/modal.php?id=2",
        "showgenerator": true,
        "showcheckstructure": true,
        "checkstructureurl": "https://example.com/ai/placement/modgen/check_structure.php?id=2",
        "showhelplinks": true,
        "helplinks": [{"text": "Module design guide", "url": "https://example.com/guide"}]
    }
}}
<nav class="navbar navbar-expand-lg navbar-dark aiplacement-modgen-navbar px-3" aria-label="{{#str}}navtitle, aiplacement_modgen{{/str}}">
    <div class="logo-container" aria-hidden="true">
        <img src="{{logourl}}" alt="" class="aiplacement-modgen-logo">
    </div>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#aimodgenNavbar" aria-controls="aimodgenNavbar" aria-expanded="false" aria-label="{{#str}}togglenav, aiplacement_modgen{{/str}}">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="aimodgenNavbar">
        <ul class="navbar-nav ml-auto">

{{#showhelplinks}}
      <li class="nav-item dropdown mx-3">
        <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-toggle="dropdown" aria-expanded="false">
          {{#str}}helpandadvice, aiplacement_modgen{{/str}}
        </a>
        <div class="dropdown-menu">
          {{#helplinks}}
          <a class="aiplacement-modgen-nav-link aiplacement-modgen-nav-link--primary" href="{{url}}" target="_blank" rel="noopener noreferrer">
            <i class="fas fa-external-link-alt mr-1" aria-hidden="true"></i>{{text}}
          </a>
          {{/helplinks}}
        </div>
      </li>
{{/showhelplinks}}

         {{#unavailable}}
         <li class="nav-item">
             <span class="navbar-text text-white small aiplacement-modgen-navbar__unavailable" role="status">
                 <i class="fa fa-info-circle mr-1" aria-hidden="true"></i>{{unavailable}}
             </span>
         </li>
         {{/unavailable}}
         {{#showquickaddmenu}}
         <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle btn btn-secondary btn-sm" href="#" role="button" data-toggle="dropdown" aria-expanded="false">
          <i class="fa fa-plus-circle mr-1" aria-hidden="true"></i> {{#str}}quickadd, aiplacement_modgen{{/str}}
        </a>
        
        <div class="dropdown-menu">
         
          {{#showquickadd}}
          {{#shownewtheme}}
          <a href="#" class="aiplacement-modgen-nav-link aiplacement-modgen-nav-link--primary" data-action="quick-add" role="button" data-form="add_theme" data-title="{{#str}}newtheme, aiplacement_modgen{{/str}}">
                    <i class="fas fa-book" aria-hidden="true"></i> {{#str}}newtheme, aiplacement_modgen{{/str}}
                </a>
          {{/shownewtheme}}
          {{#shownewweek}}
                <a href="#" class=" aiplacement-modgen-nav-link aiplacement-modgen-nav-link--primary" data-action="quick-add" role="button" data-form="add_week" data-title="{{#str}}newweek, aiplacement_modgen{{/str}}">
                    <i class="fas fa-calendar" aria-hidden="true"></i> {{#str}}newweek, aiplacement_modgen{{/str}}
                </a>
          {{/shownewweek}}
          {{#showassessments}}
                <a href="#" class="aiplacement-modgen-nav-link aiplacement-modgen-nav-link--primary" data-action="quick-add" role="button" data-form="add_assessments" data-title="{{#str}}newassessments, aiplacement_modgen{{/str}}">
                    <i class="fas fa-clipboard-check" aria-hidden="true"></i> {{#str}}newassessments, aiplacement_modgen{{/str}}
                </a>
          {{/showassessments}}
          {{/showquickadd}}
               
                {{! "Structure from file" opens the generator form (CSV/template upload).
                    It needs the generate-from-template capability, NOT AI, so it is
                    gated on showtemplatefromfile rather than showgenerator. }}
                {{#showtemplatefromfile}}
                {{#showquickadd}}<div class="dropdown-divider"></div>{{/showquickadd}}
          <a href="{{generatorurl}}" class=" aiplacement-modgen-nav-link aiplacement-modgen-nav-link--primary" data-action="open-generator">
                    <i class="fa fa-plus-circle" aria-hidden="true"></i> {{#str}}generatorlabel, aiplacement_modgen{{/str}}
                </a>
                {{/showtemplatefromfile}}
                {{#showgenerator}}
                {{! A divider before the AI option only if the file option did not already add one, and something is above. }}
                {{^showtemplatefromfile}}{{#showquickadd}}<div class="dropdown-divider"></div>{{/showquickadd}}{{/showtemplatefromfile}}
                <a href="#" class="aiplacement-modgen-nav-link aiplacement-modgen-nav-link--primary" data-action="quick-add" role="button" data-form="template_from_prompt" data-title="{{#str}}templatefromprompt, aiplacement_modgen{{/str}}">
                    <i class="fas fa-bolt" aria-hidden="true"></i> {{#str}}templatefromprompt, aiplacement_modgen{{/str}}
                </a>
          {{/showgenerator}}
        </div>
      </li>
      {{/showquickaddmenu}}
      
      {{#showcheckstructure}}
      <li class="nav-item ml-2">
        <a class="nav-link btn btn-secondary btn-sm" href="{{checkstructureurl}}">
          <i class="fa fa-stethoscope mr-1" aria-hidden="true"></i> {{#str}}checkstructure, aiplacement_modgen{{/str}}
        </a>
      </li>
      {{/showcheckstructure}}
        </ul>
    </div>
</nav>
