{{!
    Template for the simplified hierarchical "Dates for Sections" form.
    
    Context:
    - courseid: Course ID
    - sections: Hierarchical array of sections
    - hassections: Boolean indicating if sections exist
}}

<div class="dates-for-sections-form container-fluid" role="region" aria-live="polite" aria-atomic="true">
    {{#hassections}}
    <div class="mb-3">
        <p class="text-muted">{{#str}}selectsections_hierarchical, aiplacement_modgen{{/str}}</p>
        
        {{! Toggle buttons }}
        <div class="btn-group mb-3" role="group">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="toggle-all-sections">
                {{#str}}toggleall, aiplacement_modgen{{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="toggle-toplevel-sections">
                {{#str}}toggletoplevel, aiplacement_modgen{{/str}}
            </button>
        </div>
    </div>

    {{! Hierarchical section list }}
    <div class="section-hierarchy list-group">
        {{#sections}}
            {{> aiplacement_modgen/section_hierarchy_item }}
        {{/sections}}
    </div>

    {{/hassections}}

    {{^hassections}}
    <p class="alert alert-info">{{#str}}nosectionsavailable, aiplacement_modgen{{/str}}</p>
    {{/hassections}}
</div>

{{! JavaScript for handling checkboxes and dynamic date updates }}
<script>
(function() {
    'use strict';

    // Dynamic date preview when start date changes
    function updateDatePreviews() {
        const startDateSelects = form.querySelectorAll('[name^="startdate"]');
        if (!startDateSelects || startDateSelects.length === 0) {
            return;
        }

        // Get selected date from day, month, year dropdowns
        let day, month, year;
        startDateSelects.forEach(select => {
            const name = select.getAttribute('name');
            if (name.includes('[day]')) {
                day = parseInt(select.value);
            } else if (name.includes('[month]')) {
                month = parseInt(select.value);
            } else if (name.includes('[year]')) {
                year = parseInt(select.value);
            }
        });

        // Validate we have all components
        if (!day || !month || !year) {
            return;
        }

        // Create date object (month is 0-indexed in JS)
        const startDate = new Date(year, month - 1, day);
        if (isNaN(startDate.getTime())) {
            return;
        }

        // Get all checked sections in order
        const checkedSections = [];
        document.querySelectorAll('.section-checkbox:checked').forEach(function(checkbox) {
            const sectionItem = checkbox.closest('.section-item');
            if (sectionItem) {
                checkedSections.push({
                    checkbox: checkbox,
                    element: sectionItem
                });
            }
        });

        // Sort by DOM order
        checkedSections.sort((a, b) => {
            return Array.from(document.querySelectorAll('.section-item')).indexOf(a.element) -
                   Array.from(document.querySelectorAll('.section-item')).indexOf(b.element);
        });

        // Calculate and display dates for each section
        let currentDate = new Date(startDate);
        checkedSections.forEach(function(section) {
            // Ensure we start on a Monday
            const dayOfWeek = currentDate.getDay();
            if (dayOfWeek !== 1) {
                const daysUntilMonday = (dayOfWeek === 0 ? 1 : 8 - dayOfWeek);
                currentDate.setDate(currentDate.getDate() + daysUntilMonday);
            }

            const weekStart = new Date(currentDate);
            const weekEnd = new Date(currentDate);
            weekEnd.setDate(weekEnd.getDate() + 6);

            // Format date range
            const dateRange = formatDateRangeUK(weekStart, weekEnd);

            // Update the label with date preview
            const label = section.element.querySelector('label');
            const sectionName = section.element.querySelector('.section-name');

            if (sectionName && !section.element.querySelector('.date-preview')) {
                const datePreview = document.createElement('span');
                datePreview.className = 'date-preview badge bg-success text-white ms-2';
                datePreview.textContent = dateRange;
                sectionName.parentNode.insertBefore(datePreview, sectionName.nextSibling);
            } else if (section.element.querySelector('.date-preview')) {
                section.element.querySelector('.date-preview').textContent = dateRange;
            }

            // Move to next week
            currentDate.setDate(currentDate.getDate() + 7);
        });

        // Remove date previews from unchecked sections
        document.querySelectorAll('.section-checkbox:not(:checked)').forEach(function(checkbox) {
            const sectionItem = checkbox.closest('.section-item');
            if (sectionItem) {
                const datePreview = sectionItem.querySelector('.date-preview');
                if (datePreview) {
                    datePreview.remove();
                }
            }
        });
    }

    // Format date range in UK style
    function formatDateRangeUK(startDate, endDate) {
        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                           'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

        const startDay = startDate.getDate();
        const startMonth = monthNames[startDate.getMonth()];
        const endDay = endDate.getDate();
        const endMonth = monthNames[endDate.getMonth()];

        if (startMonth === endMonth) {
            return startMonth + ' ' + startDay + '–' + endDay + ':';
        } else {
            return startMonth + ' ' + startDay + '–' + endMonth + ' ' + endDay + ':';
        }
    }

    // Toggle all sections
    document.getElementById('toggle-all-sections')?.addEventListener('click', function() {
        const checkboxes = document.querySelectorAll('.section-checkbox');
        const allChecked = Array.from(checkboxes).every(cb => cb.checked);
        checkboxes.forEach(cb => cb.checked = !allChecked);
        updateDatePreviews();
    });

    // Toggle top-level sections only
    document.getElementById('toggle-toplevel-sections')?.addEventListener('click', function() {
        const topLevelCheckboxes = document.querySelectorAll('.section-checkbox[data-toplevel="true"]');
        const allChecked = Array.from(topLevelCheckboxes).every(cb => cb.checked);
        topLevelCheckboxes.forEach(cb => cb.checked = !allChecked);
        updateDatePreviews();
    });

    // Collect selected sections on form submit
    const form = document.querySelector('.dates-for-sections-form').closest('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            const checkedSections = [];
            document.querySelectorAll('.section-checkbox:checked').forEach(function(checkbox) {
                checkedSections.push(checkbox.value);
            });

            const hiddenField = form.querySelector('input[name="selectedsections"]');
            if (hiddenField) {
                hiddenField.value = JSON.stringify(checkedSections);
            }
        });

        // Listen for changes to start date
        const startDateSelects = form.querySelectorAll('[name^="startdate"]');
        startDateSelects.forEach(select => {
            select.addEventListener('change', updateDatePreviews);
        });

        // Listen for checkbox changes
        document.querySelectorAll('.section-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', updateDatePreviews);
        });

        // Initial preview on page load
        setTimeout(updateDatePreviews, 100);
    }
})();
</script>
