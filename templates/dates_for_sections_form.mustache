{{!
    Template for the simplified hierarchical "Dates for Sections" form.
    
    Context:
    - courseid: Course ID
    - sections: Hierarchical array of sections
    - hassections: Boolean indicating if sections exist
}}

<div class="dates-for-sections-form container-fluid" role="region" aria-live="polite" aria-atomic="true">
    {{#hassections}}
    <div class="mb-3">
        <p class="text-muted">{{#str}}selectsections_hierarchical, aiplacement_modgen{{/str}}</p>

        {{! Toggle buttons }}
        <div class="btn-group mb-3" role="group">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="toggle-all-sections" data-keep-in-form="true">
                {{#str}}toggleall, aiplacement_modgen{{/str}}
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="toggle-toplevel-sections" data-keep-in-form="true">
                {{#str}}toggletoplevel, aiplacement_modgen{{/str}}
            </button>
        </div>
    </div>

    {{! Column headers }}
    <div class="d-flex mb-2 px-3 border-bottom pb-2">
        <div class="flex-grow-1 fw-bold">{{#str}}sectiontitle, aiplacement_modgen{{/str}}</div>
        <div class="fw-bold text-end">{{#str}}newdate, aiplacement_modgen{{/str}}</div>
    </div>

    {{! Hierarchical section list }}
    <div class="section-hierarchy list-group">
        {{#sections}}
            {{> aiplacement_modgen/section_hierarchy_item }}
        {{/sections}}
    </div>

    {{/hassections}}

    {{^hassections}}
    <p class="alert alert-info">{{#str}}nosectionsavailable, aiplacement_modgen{{/str}}</p>
    {{/hassections}}
</div>

{{! JavaScript for handling toggle buttons and form submission }}
{{! Note: Date preview is now handled by modal_generator_reactive.js via AJAX to include holidays }}
<script>
(function() {
    'use strict';

    // Toggle all sections
    document.getElementById('toggle-all-sections')?.addEventListener('click', function() {
        const checkboxes = document.querySelectorAll('.section-checkbox');
        const allChecked = Array.from(checkboxes).every(cb => cb.checked);
        checkboxes.forEach(cb => cb.checked = !allChecked);
        // Trigger change event so reactive component updates preview
        checkboxes.forEach(cb => cb.dispatchEvent(new Event('change', { bubbles: true })));
    });

    // Toggle top-level sections only
    document.getElementById('toggle-toplevel-sections')?.addEventListener('click', function() {
        const topLevelCheckboxes = document.querySelectorAll('.section-checkbox[data-toplevel="true"]');
        const allChecked = Array.from(topLevelCheckboxes).every(cb => cb.checked);
        topLevelCheckboxes.forEach(cb => cb.checked = !allChecked);
        // Trigger change event so reactive component updates preview
        topLevelCheckboxes.forEach(cb => cb.dispatchEvent(new Event('change', { bubbles: true })));
    });

    // Collect selected sections on form submit
    const form = document.querySelector('.dates-for-sections-form')?.closest('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            const checkedSections = [];
            document.querySelectorAll('.section-checkbox:checked').forEach(function(checkbox) {
                checkedSections.push(checkbox.value);
            });

            const hiddenField = form.querySelector('input[name="selectedsections"]');
            if (hiddenField) {
                hiddenField.value = JSON.stringify(checkedSections);
            }
        });
    }
})();
</script>
