{{!
    Template for the "Dates for Sections" form.
    
    Context:
    - courseid: Course ID
    - selectsections_label: "Select sections to apply dates" label
    - currentname_label: "Current Name" column header
    - proposedname_label: "Proposed Name" column header
    - themegroups: Array of theme groups, each containing:
        - theme: Theme section data
        - weeks: Array of week sections under this theme
    - orphanweeks: Array of week sections without a parent theme
    - hasThemeGroups: Boolean indicating if theme groups exist
    - hasOrphanWeeks: Boolean indicating if orphan weeks exist
    - nosectionsavailable: Message when no sections available
}}

<div class="dates-for-sections-form container-fluid" role="region" aria-live="polite" aria-atomic="true">
    {{#selectsections_label}}
    <p class="mt-3">{{selectsections_label}}</p>
    {{/selectsections_label}}

    {{#hasThemeGroups}}
    {{#themegroups}}
    <div class="theme-group mb-4">
        {{! Theme header with checkbox }}
        <h5 class="mb-2 d-flex align-items-center">
            <input type="checkbox" 
                class="section-checkbox theme-section me-2" 
                data-section-id="{{theme.id}}" 
                value="{{theme.id}}"
                id="section-{{theme.id}}"
                aria-label="{{theme.name}}"
                checked>
            <label for="section-{{theme.id}}" class="mb-0 fw-bold">
                <span class="date-prefix">{{theme.formatted_date}} </span>{{theme.name}}
            </label>
        </h5>

        {{! Week sections table under this theme }}
        {{#hasWeeks}}
        <div class="table-responsive ms-4">
            <table class="table table-striped table-sm">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 50px;"></th>
                        <th scope="col">{{../currentname_label}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#weeks}}
                    <tr data-section-id="{{id}}" class="week-row">
                        <td>
                            <input type="checkbox" 
                                class="section-checkbox week-section" 
                                data-section-id="{{id}}" 
                                value="{{id}}"
                                id="section-{{id}}"
                                aria-label="{{name}}"
                                checked>
                        </td>
                        <td class="section-name-cell">
                            <span class="date-prefix">{{formatted_date}} </span>{{currentname}}
                        </td>
                    </tr>
                    {{/weeks}}
                </tbody>
            </table>
        </div>
        {{/hasWeeks}}
    </div>
    {{/themegroups}}
    {{/hasThemeGroups}}

    {{#hasOrphanWeeks}}
    <div class="orphan-weeks mb-4">
        <h5 class="mb-3">{{#str}}weekSections, aiplacement_modgen{{/str}}</h5>
        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th scope="col" style="width: 50px;">
                            <input type="checkbox" id="select-all-orphan-weeks" 
                                aria-label="{{#str}}selectallweeks, aiplacement_modgen{{/str}}"
                                checked>
                        </th>
                        <th scope="col">{{currentname_label}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#orphanweeks}}
                    <tr data-section-id="{{id}}" class="week-row">
                        <td>
                            <input type="checkbox" 
                                id="section-{{id}}" 
                                name="selectedsections[]" 
                                value="{{id}}" 
                                class="section-checkbox week-section"
                                data-section-id="{{id}}" 
                                aria-labelledby="section-name-{{id}}" 
                                checked>
                        </td>
                        <td id="section-name-{{id}}" class="section-name-cell">
                            <span class="date-prefix">{{formatted_date}} </span>{{currentname}}
                        </td>
                    </tr>
                    {{/orphanweeks}}
                </tbody>
            </table>
        </div>
    </div>
    {{/hasOrphanWeeks}}

    {{#nosectionsavailable}}
    <p class="alert alert-info">{{nosectionsavailable}}</p>
    {{/nosectionsavailable}}
</div>

<style>
.dates-for-sections-form .section-checkbox:not(:checked) ~ .date-prefix,
.dates-for-sections-form tr:has(.section-checkbox:not(:checked)) .date-prefix {
    display: none;
}
</style>

<script>
(function() {
    'use strict';
    
    // Select all orphan weeks
    const selectAllOrphan = document.getElementById('select-all-orphan-weeks');
    if (selectAllOrphan) {
        selectAllOrphan.addEventListener('change', function() {
            document.querySelectorAll('.orphan-weeks .section-checkbox').forEach(function(cb) {
                cb.checked = selectAllOrphan.checked;
            });
        });
    }
})();
</script>
