{{!
    @template aiplacement_modgen/generator_header

    Heading and introduction for the generator page.

    Context variables required for this template:
    * heading - Page heading
    * introduction - Introduction HTML (a language string)

    Example context (json):
    {
        "heading": "Launch Module Assistant",
        "introduction": "<p>Build a module structure from a file.</p>"
    }
}}
    
        <h2 class="mb-4">
            {{heading}}
        </h2>
        


<div class="aiplacement-modgen__content-wrapper">
    <div class="aiplacement-modgen__introduction">
        <div class="aiplacement-modgen__introduction-box">
            {{{introduction}}}
        </div>
    </div>

    
</div>
