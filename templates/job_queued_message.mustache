{{!
    @template aiplacement_modgen/job_queued_message

    Message shown in modal when job is queued for background processing.

    Context variables required for this template:
    * message - Main queued message text
    * courseurl - URL to course page

    Example context:
    {
        "message": "Creation queued - 12 sections will be created in the background.",
        "courseurl": "https://example.com/course/view.php?id=2"
    }
}}
<div class="modgen-queued-container text-center py-4">
    <div class="modgen-queued-icon mb-3">
        <i class="fa fa-clock-o fa-4x text-info" aria-hidden="true"></i>
        <span class="sr-only">{{#str}}jobqueued, aiplacement_modgen{{/str}}</span>
    </div>
    <h4 class="modgen-queued-message mb-3">{{message}}</h4>
    <div class="alert alert-info d-inline-block text-start">
        <p class="mb-0">
            {{#str}}jobqueuedinfo, aiplacement_modgen{{/str}}
        </p>
    </div>
    <div class="mt-4">
        <a href="{{courseurl}}" class="btn btn-primary btn-lg">
            {{#str}}returntocourse, aiplacement_modgen{{/str}}
        </a>
    </div>
</div>
