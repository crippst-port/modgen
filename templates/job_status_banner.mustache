{{!
    @template aiplacement_modgen/job_status_banner

    Banner for tracking background job status.

    Context variables required for this template:
    * jobcount - Number of jobs
    * singlejob - Boolean (true if only 1 job)
    * status - Job status: 'queued', 'running', 'completed', 'failed'
    * message - Status message to display
    * elapsed - Elapsed time string (e.g. "2m 30s")
    * alerttype - Bootstrap alert type: 'info', 'success', 'danger'
    * showspinner - Boolean to show loading spinner
    * showreload - Boolean to show reload button
    * showdismiss - Boolean to show dismiss button
    * courseid - Course ID for reload link

    Example context:
    {
        "jobcount": 2,
        "singlejob": false,
        "status": "running",
        "message": "2 jobs in progress",
        "elapsed": "1m 15s",
        "alerttype": "info",
        "showspinner": true,
        "showreload": false,
        "showdismiss": true,
        "courseid": 123
    }
}}
<div id="modgen-job-banner" class="alert alert-{{alerttype}} d-flex align-items-center justify-content-between mb-3" role="alert">
    <div class="d-flex align-items-center">
        {{#showspinner}}
        <div class="spinner-border spinner-border-sm me-2" role="status" aria-label="{{#str}}loading, core{{/str}}">
        </div>
        {{/showspinner}}
        <div>
            <strong>{{message}}</strong>
            {{#elapsed}}
            <span class="ms-2 text-muted">({{elapsed}})</span>
            {{/elapsed}}
        </div>
    </div>
    <div class="d-flex align-items-center">
        {{#showreload}}
        <a href="{{wwwroot}}/course/view.php?id={{courseid}}" 
           class="btn btn-sm btn-primary me-2" 
           data-action="reload-page">
            {{#str}}reloadpage, aiplacement_modgen{{/str}}
        </a>
        {{/showreload}}
        {{#showdismiss}}
        <button type="button" class="btn-close" data-action="dismiss-banner" aria-label="{{#str}}close, core{{/str}}"></button>
        {{/showdismiss}}
    </div>
</div>
