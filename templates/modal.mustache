{{!
    @template aiplacement_modgen/modal

    Modal wrapper for the Module Assistant workflow: the core modal with the plugin's classes.

    Context variables required for this template:
    * title - Modal title
    * body - Modal body HTML
    * footer - Modal footer HTML

    Example context (json):
    {
        "title": "Structure from prompt",
        "body": "<p>Enter a prompt</p>",
        "footer": ""
    }
}}
{{< core/modal }}
    {{$classes}}modal-dialog-scrollable modal-lg aiplacement-modgen__modal{{/classes}}
    {{$bodyclasses}}aiplacement-modgen__modal-body{{/bodyclasses}}
    {{$footerclasses}}aiplacement-modgen__modal-footer{{/footerclasses}}
{{/ core/modal }}
