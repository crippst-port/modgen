{{!
    @template aiplacement_modgen/modal_footer

    Action area for the Module Assistant modal footer.

    Context variables required for this template:
    * actions - Buttons and links, each with label, classes, and isbutton or islink; optional action,
      url (links), and hasindex/index (buttons that stand in for a form's own button)

    Example context (json):
    {
        "actions": [
            {"isbutton": true, "label": "Try again", "classes": "btn btn-primary", "action": "aiplacement-modgen-reenter"},
            {"islink": true, "label": "Back to course", "classes": "btn btn-secondary", "url": "#"}
        ]
    }
}}
<div class="aiplacement-modgen-modal-actions">
    {{#actions}}
        {{#isbutton}}
    <button type="button" class="{{classes}}" {{#action}}data-action="{{.}}"{{/action}} {{#hasindex}}data-button-index="{{index}}"{{/hasindex}}>
            {{label}}
        </button>
        {{/isbutton}}
        {{#islink}}
        <a class="{{classes}}" href="{{url}}" {{#action}}data-action="{{.}}"{{/action}}>
            {{label}}
        </a>
        {{/islink}}
    {{/actions}}
</div>
