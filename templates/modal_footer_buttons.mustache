{{!
    @template aiplacement_modgen/modal_footer_buttons

    Modal footer buttons template for consistent button rendering.

    Context variables required for this template:
    * buttons - Array of button objects with the following properties:
        - label: Button text label
        - action: Data action attribute value
        - class: CSS classes (e.g., 'btn-primary', 'btn-secondary')
        - index: Button index for identification

    Example context (json):
    {
        "buttons": [
            {
                "label": "Cancel",
                "action": "close",
                "class": "btn-secondary",
                "index": 0
            },
            {
                "label": "Return to course",
                "action": "return-to-course",
                "class": "btn-primary",
                "index": 1
            }
        ]
    }
}}
<div class="aiplacement-modgen-form-footer-buttons d-flex justify-content-end">
    {{#buttons}}
    <button type="button" class="btn {{class}}{{#index}} ml-2{{/index}}" data-action="{{action}}" data-button-index="{{index}}">
        {{label}}
    </button>
    {{/buttons}}
</div>
