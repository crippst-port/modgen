{{!
    @template aiplacement_modgen/modal_link

    Link from the modal to the standalone generator page.

    Context variables required for this template:
    * generatorurl - URL of the standalone generator page

    Example context (json):
    {
        "generatorurl": "https://example.com/ai/placement/modgen/prompt.php?id=2"
    }
}}
<div class="aiplacement-modgen__modal-link">
    <p>{{#str}}modalintro,aiplacement_modgen{{/str}}</p>
    <a href="{{generatorurl}}" class="btn btn-primary" target="_blank">
        {{#str}}launchgenerator,aiplacement_modgen{{/str}}
    </a>
</div>
