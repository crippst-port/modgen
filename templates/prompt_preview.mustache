{{!
    @template aiplacement_modgen/prompt_preview

    Preview of a proposed module structure, shown for approval before anything is created. Rendered
    inside the approval form: every theme and week has a title and a description field, named by
    where it sits in the structure (see structure_edits), which are applied when it is approved.
    amd/src/preview_editor.js shows the buttons that fold cards and add themes and weeks.

    Context variables required for this template:
    * hasprompt - Whether the prompt is shown
    * prompttext - The prompt
    * modulepreview - The structure: hasthemes and themes, or hasweeks and weeks, with themecount and
      weekcount. A theme has key, number, rawtitle, placeholder, summary, hasweeks and weeks; a week
      has key, number, rawtitle, placeholder, summary, hassessions and sessions (each with label and
      activities), and hasactivities and activities (each with name and type)
    * newtheme, newweek - The blank theme and week the Add buttons copy, keyed __KEY__ (see
      aiplacement_modgen/prompt_preview_theme and aiplacement_modgen/prompt_preview_week)
    * hasjson - Whether the structure can be downloaded
    * json - The structure as URL-encoded JSON, for the download link

    Example context (json):
    {
        "hasprompt": true,
        "prompttext": "A twelve week module on rivers",
        "modulepreview": {
            "hasthemes": false,
            "hasweeks": true,
            "themecount": 0,
            "weekcount": 1,
            "weeks": [{
                "key": "0",
                "number": 1,
                "rawtitle": "Week 1",
                "placeholder": "Week",
                "summary": "Introduction",
                "hassessions": true,
                "hasactivities": true,
                "sessions": [{"label": "Session", "activities": [{"name": "Seminar", "type": "learningactivity"}]}]
            }]
        },
        "hasjson": true,
        "json": "%7B%7D"
    }
}}
<div class="aiplacement-modgen-preview">
    <div class="aiplacement-modgen-preview__intro">
        <span class="aiplacement-modgen-preview__intro-icon" aria-hidden="true"><i class="fa fa-list-check"></i></span>
        <div>
            <h3 class="aiplacement-modgen-preview__heading">{{#str}}previewheading, aiplacement_modgen{{/str}}</h3>
            <p class="aiplacement-modgen-preview__intro-text">{{#str}}previewintro, aiplacement_modgen{{/str}}</p>
        </div>
    </div>

    {{#modulepreview}}
    <div class="aiplacement-modgen-preview__toolbar">
        <ul class="aiplacement-modgen-preview__counts">
            {{#hasthemes}}<li><i class="fa fa-book" aria-hidden="true"></i> {{#str}}previewcountthemes, aiplacement_modgen, <span data-count="themes">{{themecount}}</span>{{/str}}</li>{{/hasthemes}}
            <li><i class="fa fa-calendar" aria-hidden="true"></i> {{#str}}previewcountweeks, aiplacement_modgen, <span data-count="weeks">{{weekcount}}</span>{{/str}}</li>
        </ul>
        <button type="button" class="btn btn-link btn-sm aiplacement-modgen-preview__toggleall" data-action="toggleall"
            data-state="expanded" data-collapselabel="{{#str}}previewcollapseall, aiplacement_modgen{{/str}}"
            data-expandlabel="{{#str}}previewexpandall, aiplacement_modgen{{/str}}" data-preview-control data-keep-in-form hidden>{{#str}}previewcollapseall, aiplacement_modgen{{/str}}</button>
    </div>
    {{/modulepreview}}

    {{#hasprompt}}
    <details class="aiplacement-modgen-preview__prompt">
        <summary>{{#str}}generationresultspromptheading, aiplacement_modgen{{/str}}</summary>
        <p>{{prompttext}}</p>
    </details>
    {{/hasprompt}}

    {{#modulepreview}}
    <div class="aiplacement-modgen-preview__structure">
        {{#hasthemes}}
        {{#themes}}{{> aiplacement_modgen/prompt_preview_theme }}{{/themes}}
        <button type="button" class="btn btn-link aiplacement-modgen-preview__add" data-action="addtheme" data-preview-control data-keep-in-form hidden>
            <i class="fa fa-plus" aria-hidden="true"></i> {{#str}}previewaddtheme, aiplacement_modgen{{/str}}
        </button>
        {{/hasthemes}}

        {{^hasthemes}}
        {{#hasweeks}}
        {{#weeks}}{{> aiplacement_modgen/prompt_preview_week }}{{/weeks}}
        <button type="button" class="btn btn-link aiplacement-modgen-preview__add" data-action="addweek" data-themekey=""
            data-preview-control data-keep-in-form hidden>
            <i class="fa fa-plus" aria-hidden="true"></i> {{#str}}previewaddweek, aiplacement_modgen{{/str}}
        </button>
        {{/hasweeks}}
        {{^hasweeks}}
        <p class="alert alert-warning">{{#str}}previewnostructure, aiplacement_modgen{{/str}}</p>
        {{/hasweeks}}
        {{/hasthemes}}
    </div>

    {{! Blank cards the Add buttons copy, with __KEY__ where the new key goes. }}
    {{#hasthemes}}{{#newtheme}}<template data-preview-template="theme">{{> aiplacement_modgen/prompt_preview_theme }}</template>{{/newtheme}}{{/hasthemes}}
    {{#newweek}}<template data-preview-template="week">{{> aiplacement_modgen/prompt_preview_week }}</template>{{/newweek}}
    {{/modulepreview}}

    {{#hasjson}}
    <p class="aiplacement-modgen-preview__download">
        <a href="data:application/json;charset=utf-8,{{json}}" download="module-structure.json">
            <i class="fa fa-download" aria-hidden="true"></i> {{#str}}downloadjson, aiplacement_modgen{{/str}}
        </a>
    </p>
    {{/hasjson}}
</div>
