{{!
    @template aiplacement_modgen/prompt_preview_week

    One week on the structure preview, with its title and description fields and, folded away, its
    sessions and activities. The fold and remove buttons are hidden until amd/src/preview_editor.js
    shows them.

    Context variables required for this template:
    * key - Where the week sits in the structure, for the field names (__KEY__ in the blank copy)
    * number - Its place among all the weeks, from 1
    * isnew - Whether it is the blank copy that an Add week button adds
    * rawtitle - Its title as given, possibly empty
    * placeholder - What it is called when it has no title
    * summary - Its description
    * hassessions, sessions - Its sessions, each with label and activities (name and type)
    * hasactivities, activities - Its activities when it has no sessions

    Example context (json):
    {
        "key": "0_1",
        "number": 2,
        "isnew": false,
        "rawtitle": "Rivers in flood",
        "placeholder": "Week",
        "summary": "",
        "hassessions": true,
        "hasactivities": true,
        "sessions": [{"label": "Pre-session", "activities": [{"name": "Reading", "type": "page"}]}]
    }
}}
<div class="aiplacement-modgen-preview__card aiplacement-modgen-preview__card--week">
    <div class="aiplacement-modgen-preview__card-head">
        <button type="button" class="aiplacement-modgen-preview__toggle" data-action="toggle" data-preview-control data-keep-in-form
            aria-expanded="true" aria-controls="aiplacement-modgen-body-w{{key}}" hidden>
            <i class="fa fa-chevron-down" aria-hidden="true"></i>
            <span class="sr-only">{{#str}}previewtoggle, aiplacement_modgen{{/str}}</span>
        </button>
        <span class="aiplacement-modgen-preview__badge aiplacement-modgen-preview__badge--week">
            <i class="fa fa-calendar" aria-hidden="true"></i>
            {{#isnew}}{{#str}}previewbadgenewweek, aiplacement_modgen{{/str}}{{/isnew}}{{^isnew}}{{#str}}previewbadgeweek, aiplacement_modgen, {{number}}{{/str}}{{/isnew}}
        </span>
        <label class="sr-only" for="aiplacement-modgen-title-w{{key}}">{{#isnew}}{{#str}}previewtitlelabelnewweek, aiplacement_modgen{{/str}}{{/isnew}}{{^isnew}}{{#str}}previewtitlelabelweek, aiplacement_modgen, {{number}}{{/str}}{{/isnew}}</label>
        <input type="text" class="form-control aiplacement-modgen-preview__title" id="aiplacement-modgen-title-w{{key}}"
            name="titles[w{{key}}]" value="{{rawtitle}}" placeholder="{{placeholder}}" maxlength="255">
        {{#isnew}}
        <button type="button" class="aiplacement-modgen-preview__remove" data-action="remove" data-preview-control data-keep-in-form hidden>
            <i class="fa fa-trash" aria-hidden="true"></i>
            <span class="sr-only">{{#str}}previewremoveweek, aiplacement_modgen{{/str}}</span>
        </button>
        {{/isnew}}
    </div>
    <div class="aiplacement-modgen-preview__card-body" id="aiplacement-modgen-body-w{{key}}">
        <label class="sr-only" for="aiplacement-modgen-summary-w{{key}}">{{#isnew}}{{#str}}previewsummarylabelnewweek, aiplacement_modgen{{/str}}{{/isnew}}{{^isnew}}{{#str}}previewsummarylabelweek, aiplacement_modgen, {{number}}{{/str}}{{/isnew}}</label>
        <textarea class="form-control aiplacement-modgen-preview__summary" id="aiplacement-modgen-summary-w{{key}}"
            name="summaries[w{{key}}]" rows="2"
            placeholder="{{#str}}previewsummaryplaceholder, aiplacement_modgen{{/str}}">{{summary}}</textarea>

        {{#hasactivities}}
        <details class="aiplacement-modgen-preview__contents">
            <summary>{{#str}}previewcontents, aiplacement_modgen{{/str}}</summary>
            {{#hassessions}}
            <div class="aiplacement-modgen-preview__sessions">
                {{#sessions}}
                <div class="aiplacement-modgen-preview__session">
                    <span class="aiplacement-modgen-preview__session-label">{{label}}</span>
                    <ul class="aiplacement-modgen-preview__activities">
                        {{#activities}}
                        <li>{{name}}{{#type}} <span class="aiplacement-modgen-preview__activity-type">{{type}}</span>{{/type}}</li>
                        {{/activities}}
                        {{^activities}}
                        <li class="aiplacement-modgen-preview__none">{{#str}}previewnoactivities, aiplacement_modgen{{/str}}</li>
                        {{/activities}}
                    </ul>
                </div>
                {{/sessions}}
            </div>
            {{/hassessions}}
            {{^hassessions}}
            <ul class="aiplacement-modgen-preview__activities">
                {{#activities}}
                <li>{{name}}{{#type}} <span class="aiplacement-modgen-preview__activity-type">{{type}}</span>{{/type}}</li>
                {{/activities}}
            </ul>
            {{/hassessions}}
        </details>
        {{/hasactivities}}
    </div>
</div>
