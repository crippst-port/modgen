{{!
    @template aiplacement_modgen/reorder_status_icon

    Status icon for the automatic section renumber, shown to site administrators on the assistant bar.

    Context variables required for this template:
    * state - queued, running, renumbered, checked or blocked
    * label - Text for the tooltip and screen readers
    * url - Check Structure link, only for the blocked state
    * wait - Seconds until a queued renumber runs, by the server's clock
    * isqueued, isrunning, isrenumbered, ischecked, isblocked - Booleans for the state
    * isdone - Whether the run finished (renumbered or checked), shown with a tick

    Example context (json):
    {
        "state": "queued",
        "label": "Section reorder queued · runs 14:32",
        "wait": 45,
        "url": null,
        "isqueued": true,
        "isrunning": false,
        "isrenumbered": false,
        "ischecked": false,
        "isblocked": false,
        "isdone": false
    }
}}
{{#isblocked}}
<a href="{{url}}" class="aiplacement-modgen-reorder-icon aiplacement-modgen-reorder-icon--blocked" role="img" aria-label="{{label}}" title="{{label}}" data-toggle="tooltip">
    <i class="fa fa-exclamation-circle" aria-hidden="true"></i>
</a>
{{/isblocked}}
{{^isblocked}}
<span class="aiplacement-modgen-reorder-icon aiplacement-modgen-reorder-icon--{{state}}" tabindex="0" role="img" aria-label="{{label}}" title="{{label}}" data-toggle="tooltip"{{#isqueued}} data-wait="{{wait}}"{{/isqueued}}>
    {{#isqueued}}<i class="fa fa-clock" aria-hidden="true"></i>{{/isqueued}}
    {{#isrunning}}<i class="fa fa-play-circle" aria-hidden="true"></i>{{/isrunning}}
    {{#isdone}}<i class="fa fa-check-circle" aria-hidden="true"></i>{{/isdone}}
</span>
{{/isblocked}}
