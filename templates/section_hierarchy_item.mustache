{{!
    Partial template for rendering a single section in the hierarchy.
    Recursively includes itself for child sections.
    
    Context:
    - id: Section ID
    - name: Section name
    - level: Nesting level
    - indent: HTML indent string
    - istoplevel: Boolean if this is a top-level section
    - haschildren: Boolean if this section has children
    - children: Array of child sections
}}

<div class="list-group-item section-item" data-level="{{level}}" data-section-id="{{id}}" style="padding-left: {{level}}.4rem; {{#haschildren}}background-color: #efefef;{{/haschildren}}">
    <label class="d-flex align-items-center mb-0 py-2">
        <input type="checkbox"
            class="section-checkbox me-3"
            value="{{id}}"
            data-section-id="{{id}}"
            {{#istoplevel}}data-toplevel="true"{{/istoplevel}}
            checked>
        <span class="section-name flex-grow-1">{{name}}</span>
        <span class="date-prefix"></span>
    </label>
</div>

{{! Recursively render children }}
{{#children}}
    {{> aiplacement_modgen/section_hierarchy_item }}
{{/children}}
