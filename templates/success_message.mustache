{{!
    @template aiplacement_modgen/success_message

    Success message template for modal operations.

    Context variables required for this template:
    * message - Main success message text
    * hasdetails - Boolean indicating if details array is present
    * details - Optional array of detail messages to show in a list
    * showcoursereturn - Optional boolean to show "Return to course" button in body
    * courseurl - Optional URL to course page (required if showcoursereturn is true)

    Note: Set showcoursereturn to true only for standalone pages without modal footers.
    For modal contexts, use footer buttons instead to follow Moodle UX patterns.

    Example context (json):
    {
        "message": "Successfully created 3 sections",
        "hasdetails": true,
        "details": [
            "Section created: Theme 1",
            "Section created: Week 1", 
            "Section created: Week 2"
        ],
        "showcoursereturn": false,
        "courseurl": "https://example.com/course/view.php?id=2"
    }
}}
<div class="modgen-success-container text-center py-4">
    <div class="modgen-success-icon mb-3">
        <i class="fa fa-check-circle fa-4x text-success" aria-hidden="true"></i>
        <span class="sr-only">{{#str}}successicon, aiplacement_modgen{{/str}}</span>
    </div>
    <h4 class="modgen-success-message mb-3">{{message}}</h4>
    {{#hasdetails}}
    <div class="modgen-success-details mt-3">
        <p class="mb-2">
            <a href="#" class="btn btn-sm btn-outline-secondary" 
               data-toggle="collapse" 
               data-target="#modgen-details-list" 
               aria-expanded="false" 
               aria-controls="modgen-details-list"
               aria-label="{{#str}}showdetailsaria, aiplacement_modgen{{/str}}">
                <i class="fa fa-list-ul" aria-hidden="true"></i> {{#str}}seedetails, aiplacement_modgen{{/str}}
            </a>
        </p>
        <div class="collapse" id="modgen-details-list">
            <div class="card card-body text-left">
                <ul class="mb-0">
                    {{#details}}
                    <li>{{.}}</li>
                    {{/details}}
                </ul>
            </div>
        </div>
    </div>
    {{/hasdetails}}
    {{#showcoursereturn}}
    <div class="modgen-success-return mt-4">
        <a href="{{courseurl}}" class="btn btn-primary">
            {{#str}}returntocourse, aiplacement_modgen{{/str}}
        </a>
    </div>
    {{/showcoursereturn}}
</div>
